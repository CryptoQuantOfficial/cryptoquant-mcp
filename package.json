{
  "name": "cryptoquant-mcp",
  "mcpName": "com.cryptoquant/mcp-server",
  "version": "0.2.0",
  "description": "CryptoQuant MCP stdio proxy - connects MCP clients to the remote CryptoQuant MCP server",
  "type": "module",
  "bin": {
    "cryptoquant-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/ test/",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:metric-ids": "tsx test/helpers/sync-metric-ids.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cryptoquant",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "on-chain",
    "bitcoin",
    "ethereum",
    "crypto",
    "analytics",
    "ai-agent",
    "mcp-server",
    "on-chain-analytics"
  ],
  "author": "CryptoQuant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CryptoQuantOfficial/cryptoquant-mcp.git"
  },
  "homepage": "https://github.com/CryptoQuantOfficial/cryptoquant-mcp#readme",
  "bugs": {
    "url": "https://github.com/CryptoQuantOfficial/cryptoquant-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
